<%- include('partes/header_tasks')%> 
    <div class="container py-5" style="max-width: 820px;">
        <h1 class="h3 text-center mb-4">Minhas tarefas</h1>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div class="d-flex gap-2">
        <a href="/" class="btn btn-primary btn-sm">Voltar ao início</a>
        <a href="/tasks" class="btn btn-primary btn-sm">Limpar filtro</a>
    </div>

    <div class="d-flex gap-2">
        <form action="/tasks/filtrarTasks" method="get" class="d-flex gap-2">
            <select name="completed" class="form-select form-select-sm w-auto">
                <option value="0" <%= filtro ? '' : 'selected' %>>Pendente</option>
                <option value="1" <%= filtro ? 'selected' : '' %>>Concluída</option>
            </select>
            <button type="submit" class="btn btn-success btn-sm">Filtrar</button>
        </form>

        <form action="/tasks/deletarAll" method="post">
            <button type="submit" class="btn btn-danger btn-sm">Delete todos</button>
        </form>
    </div>

</div>

        <form action="/tasks/create" method="post" class="card card-body shadow-sm mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    <input type="text" name="title" class="form-control" placeholder="Nova tarefa" required>
                </div>
                <div class="col-6 col-md-3">
                    <select name="completed" class="form-select">
                        <option value="0">Pendente</option>
                        <option value="1">Concluída</option>
                    </select>
                </div>
                <div class="col-6 col-md-auto">
                    <button type="submit" class="btn btn-primary w-100">Adicionar</button>
                </div>
            </div>
        </form>

        <% if (tasks.length===0) { %>
            <div class="alert alert-secondary">Nenhuma tarefa encontrada.</div>
            <% } %>

                <ul class="list-group shadow-sm">
                    <% tasks.forEach(t=> { %>
                        <li class="list-group-item d-flex gap-2 align-items-center">

                            <form action="/tasks/atualizar" method="post" class="d-flex gap-2 flex-grow-1">
                                <input type="hidden" name="id" value="<%= t.id %>">
                                <input type="text" name="title" value="<%= t.title %>" class="form-control"" required>
                                <select name="completed" class="form-select w-auto">
                                    <option value="0" <%=t.completed ? '' : 'selected' %>>Pendente</option>
                                    <option value="1" <%=t.completed ? 'selected' : '' %>>Concluída</option>
                                </select>
                                <button type="submit" class="btn btn-success">Atualizar</button>
                            </form>

                            <form action="/tasks/deletar" method="post">
                                <input type="hidden" name="id" value="<%= t.id %>">
                                <button type="submit" class="btn btn-danger">Deletar</button>
                            </form>

                        </li>
                        <% }) %>
                </ul>
    </div>
<%- include('partes/footer')%>
